# Havix 节点环境变量示例
# 复制为 .env 后按需修改。所有变量均可省略，节点会用默认值启动。

# ──────────────────────────────────────────────
# 基础配置
# ──────────────────────────────────────────────

# 节点监听端口。0 = 随机可用端口（默认，推荐用于多节点本地测试）
HAVIX_PORT=0

# 节点显示名称（仅用于日志，不影响协议层 PeerId）
HAVIX_NAME=havix-node

# 节点数据目录（libp2p / helia 的本地持久化目录）
HAVIX_DATA_DIR=.data

# ──────────────────────────────────────────────
# 网络发现
# ──────────────────────────────────────────────

# 是否启用 mDNS 局域网自动发现（true/false）。默认 true。
HAVIX_MDNS=true

# 跨网段引导节点列表（逗号分隔的 multiaddr）
# 例如：/ip4/192.168.1.10/tcp/9001/p2p/12D3Koo...
# 留空则不引导，仅依赖 mDNS。
HAVIX_BOOTSTRAP=

# 是否启用 KadDHT（true/false）。默认 true。
HAVIX_DHT=true

# DHT 模式：lan | wan
# lan = 仅局域网 DHT（默认，不接入公网 IPFS Amino DHT）
# wan = 接入公网 IPFS DHT
HAVIX_DHT_MODE=lan

# ──────────────────────────────────────────────
# 调试
# ──────────────────────────────────────────────

# 日志级别：debug | info | warn | error
HAVIX_LOG=info

# ──────────────────────────────────────────────
# 应用层（M8.2）
# ──────────────────────────────────────────────

# 是否启动后进入 CLI REPL（true/false）。默认 true。
# 设为 false 时节点以无交互方式运行（适合服务化部署）。
HAVIX_REPL=true

# 是否启动本地 Web 面板（true/false）。默认 true。
# Web 面板提供拓扑可视化与 JSON API，仅绑定 127.0.0.1。
HAVIX_WEB=true

# Web 面板端口（0 = 随机可用端口）。默认 7331。
HAVIX_WEB_PORT=7331

# Web 面板监听地址。默认 127.0.0.1（仅本地访问）。
# 安全约束：不要改为 0.0.0.0 暴露公网（M8.2 无认证机制，远程访问会泄露所有 registry 数据）。
# 如需远程访问，建议通过 SSH 隧道或反向代理（带认证）转发到 127.0.0.1:7331。
HAVIX_WEB_HOST=127.0.0.1

